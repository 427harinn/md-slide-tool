{
  "name": "md-slide-tool-powerpoint",
  "displayName": "md-slide-tool PowerPoint",
  "version": "0.1.0",
  "publisher": "md-slide-tool",
  "description": "Build PPTX files in the Dev Container and open them in the host PowerPoint app.",
  "main": "./src/extension.js",
  "type": "module",
  "engines": {
    "vscode": "^1.92.0"
  },
  "activationEvents": [
    "onCommand:mdSlideTool.openPptxPreview",
    "onCommand:mdSlideTool.buildAndOpenPowerPoint"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdSlideTool.openPptxPreview",
        "title": "Open PPTX Preview",
        "category": "md-slide-tool"
      },
      {
        "command": "mdSlideTool.buildAndOpenPowerPoint",
        "title": "Build and Open in Microsoft PowerPoint",
        "category": "md-slide-tool"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdSlideTool.openPptxPreview",
          "when": "resourceExtname == .pptx",
          "group": "navigation@50"
        },
        {
          "command": "mdSlideTool.buildAndOpenPowerPoint",
          "when": "resourceExtname == .qmd",
          "group": "navigation@50"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/copy-pdfjs.js && node ./scripts/verify-package.js",
    "watch": "node --watch ./scripts/verify-package.js",
    "test": "node --test test/*.test.js",
    "package:check": "npm run build && npm pack --dry-run",
    "copy:pdfjs": "node ./scripts/copy-pdfjs.js"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "files": [
    "src",
    "webview",
    "package.json",
    "README.md"
  ],
  "extensionKind": [
    "workspace"
  ]
}
