{
    "name": "md-slide-tool",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "workspaceFolder": "/work",
    "remoteEnv": {
        "MD_SLIDE_TOOL_HOST_WORKSPACE": "${localWorkspaceFolder}"
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/work,type=bind"
    ],
    "postCreateCommand": "bash /work/scripts/devcontainer-setup.sh",
    "postStartCommand": "bash /work/scripts/install-vscode-extension.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "quarto.quarto",
                "yzhang.markdown-all-in-one",
                "augustocdias.tasks-shell-input"
            ]
        }
    }
}
